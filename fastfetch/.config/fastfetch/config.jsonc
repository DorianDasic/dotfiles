{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
	"type": "auto",
        "source": "$(readlink -f $HOME/.config/fastfetch/config.jsonc | xargs dirname)/buster.png",
        "width": 20,
	"height": 10,
	"padding": {
            "top": 2,
            "right": 2
        },
	"preserveAspectRatio": false
    },
    "display": {
        "separator": " •  "
    },
    "modules": [
	"break",
	"break",
	{
            "type": "title",
            "color": {
                "user": "35",  // = color2
                "at": "37",
                "host": "35"
            }
        },
        "break",
        {
            "type": "os",
            "key": "distribution   ",
            "keyColor": "33",
        },
        {
            "type": "kernel",
            "key": "linux kernel   ",
            "keyColor": "34",
        },
        {
            "type": "packages",
            //"format": "{} (pacman)",
            "key": "packages       ",
            "keyColor": "31",  
        },
        {
            "type": "shell",
            "key": "unix shell     ",
            "keyColor": "36", 
        },
        {
            "type": "terminal",
            "key": "terminal       ",
            "keyColor": "37", 
        },
        {
            "type": "wm",
            "format": "{} ({3})",
            "key": "window manager ",
            "keyColor": "39", 
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
        }
    ]
}

