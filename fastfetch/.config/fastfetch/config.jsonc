{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
	      "type": "kitty-direct",
        "source": "~/dotfiles/fastfetch/.config/fastfetch/buster.png",
        "width": 20,
	      "height": 10,
	        "padding": {
            "top": 2,
            "right": 2
          },
	    "preserveAspectRatio": false
    },
    "display": {
        "separator": " ›  "
    },
    "modules": [
	"break",
	"break",
	{
            "type": "title",
            "color": {
                "user": "35",  // = color2
                "at": "37",
                "host": "35"
            }
        },
        "break",
        {
            "type": "os",
            "key": "os       ",
            "keyColor": "33",
        },
        {
            "type": "terminal",
            "key": "terminal ",
            "keyColor": "34",
        },
        {
            "type": "packages",
            //"format": "{} (pacman)",
            "key": "packages ",
            "keyColor": "32",  
        },
        {
            "type": "shell",
            "key": "shell    ",
            "keyColor": "36", 
        },
        {
            "type": "uptime",
            "key": "uptime   ",
            "keyColor": "37", 
        },
        {
            "type": "memory",
            "key": "memory   ",
            "keyColor": "31", 
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
        }
    ]
}

